{
  "manifest_version": 3,
  "name": "Plano Governance Guard",
  "version": "1.0.0",
  "description": "Consulta obligatoriamente a Plano antes de enviar prompts en las interfaces web de demostración.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://governed-agent:10600/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://grok.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://claude.ai/*", "https://grok.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
