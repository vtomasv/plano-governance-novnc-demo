# Dirección de escucha del host.
# Mantenga 127.0.0.1 para una demo local segura. Use 0.0.0.0 solo si necesita
# acceso desde otra máquina y protege los puertos con firewall/VPN.
BIND_ADDRESS=127.0.0.1

# Escritorios noVNC
CHATGPT_NOVNC_PORT=6080
CLAUDE_NOVNC_PORT=6081
GROK_NOVNC_PORT=6082
VNC_PASSWORD=plano-demo

# Panel de control y agente gobernado
CONTROL_CENTER_PORT=10000
GOVERNED_AGENT_PORT=10600

# Plano: listener LLM, listener de agentes y Envoy Admin
PLANO_PORT=12000
PLANO_AGENT_PORT=8001
PLANO_ADMIN_PORT=19901

# Guardrail y proveedores simulados
POLICY_GUARD_PORT=10500
PROVIDER_SIM_PORT=10501
PROVIDER_TLS_PORT=18443

# Observabilidad
JAEGER_UI_PORT=16686
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
MITMPROXY_UI_PORT=8081
MITMWEB_PASSWORD=plano-demo

# Credenciales opcionales para docker-compose.real-api.yml.
# La demo local no las requiere.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROK_API_KEY=

# Seguridad de la demo
POLICY_FAIL_MODE=closed
LOG_PROMPT_BODIES=false

# Regenerar la CA solo de forma intencional:
# FORCE_CA_REGEN=1 docker compose run --rm cert-init
FORCE_CA_REGEN=0
