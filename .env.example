# Puertos de los escritorios noVNC
CHATGPT_NOVNC_PORT=6080
CLAUDE_NOVNC_PORT=6081
GROK_NOVNC_PORT=6082

# Puertos de Plano y observabilidad
PLANO_PORT=12000
JAEGER_UI_PORT=16686
MITMPROXY_UI_PORT=8081

# Credenciales opcionales para config.real.yaml. La demo local no las requiere.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROK_API_KEY=

# Seguridad de la demo
VNC_PASSWORD=plano-demo
POLICY_FAIL_MODE=closed
LOG_PROMPT_BODIES=false

# Regenerar CA solo de forma intencionada: FORCE_CA_REGEN=1 docker compose run --rm cert-init
FORCE_CA_REGEN=0
